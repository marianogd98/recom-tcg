{
  "name": "@recom-tcg/pipeline",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "description": "Build-time data pipeline: Scryfall bulk data → normalized, tagged, versioned artifacts for the browser.",
  "type": "module",
  "scripts": {
    "data:fetch": "tsx src/cli/fetch-data.ts",
    "data:build": "tsx src/cli/build-data.ts",
    "data:embed": "tsx src/cli/embed-data.ts",
    "rules:report": "tsx src/cli/rules-report.ts",
    "pool:import": "tsx src/cli/import-pool.ts",
    "pool:candidates": "tsx src/cli/pool-candidates.ts",
    "fixtures:sync": "tsx src/cli/sync-fixtures.ts",
    "test": "tsx --test \"src/**/*.test.ts\"",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@huggingface/transformers": "^3.7.0",
    "@recom-tcg/engine": "workspace:*",
    "@recom-tcg/rules-schema": "workspace:*",
    "yaml": "^2.8.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  }
