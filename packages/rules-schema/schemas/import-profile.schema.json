{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "urn:recom-tcg:schema:import-profile",
  "title": "ReCom TCG import profile",
  "type": "object",
  "required": ["schema_version", "id", "detect", "columns"],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "const": 1 },
    "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
    "detect": {
      "type": "object",
      "required": ["header_contains"],
      "additionalProperties": false,
      "properties": {
        "header_contains": { "type": "array", "minItems": 1, "items": { "type": "string" } }
      }
    },
    "columns": {
      "type": "object",
      "required": ["name"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string" },
        "quantity": { "type": "string" },
        "language": { "type": "string" }
      }
    }
  }
}
