{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "urn:recom-tcg:schema:overrides",
  "title": "ReCom TCG overrides",
  "description": "Card-by-card corrections (gramática YAML §3.8). They only add or remove tags, never scores.",
  "type": "object",
  "required": ["schema_version", "overrides"],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "const": 1 },
    "overrides": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["card", "reason"],
        "anyOf": [{ "required": ["add"] }, { "required": ["remove"] }],
        "additionalProperties": false,
        "properties": {
          "card": {
            "type": "string",
            "minLength": 1,
            "description": "English Oracle name, exactly as Scryfall writes it. The build fails if no card has this name."
          },
          "reason": {
            "type": "string",
            "minLength": 10,
            "description": "Why the rules get this card wrong. Reviewed in the pull request."
          },
          "add": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["weight"],
              "additionalProperties": false,
              "oneOf": [
                { "required": ["theme", "provides"], "not": { "required": ["role"] } },
                { "required": ["role"], "not": { "anyOf": [{ "required": ["theme"] }, { "required": ["provides"] }] } }
              ],
              "properties": {
                "theme": { "type": "string", "pattern": "^[a-z_]+(?::[a-z0-9_-]+)?$" },
                "role": { "type": "string", "pattern": "^[a-z_]+$" },
                "provides": { "enum": ["asks", "gives"] },
                "weight": { "type": "number", "minimum": 0.1, "maximum": 1 }
              }
            }
          },
          "remove": {
            "type": "array",
            "minItems": 1,
            "description": "\"counters\" removes both directions, \"counters/gives\" only one, \"tribal\" every tribal:* tag, \"tribal:elf\" just that one. Roles by id.",
            "items": { "type": "string", "pattern": "^[a-z_]+(?::[a-z0-9_-]+)?(?:/(?:asks|gives))?$" }
          }
        }
      }
    }
  }
}
