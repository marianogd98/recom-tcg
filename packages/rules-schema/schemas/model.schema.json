{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "urn:recom-tcg:schema:model",
  "title": "ReCom TCG model parameters",
  "type": "object",
  "required": [
    "schema_version",
    "version",
    "synergy",
    "semantic",
    "lands",
    "utility",
    "theme_support",
    "confidence",
    "profiles",
    "tiebreak",
    "import"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 1
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "synergy": {
      "type": "object",
      "required": [
        "alpha_rules",
        "k",
        "semantic_calibration",
        "pair_affinity"
      ],
      "properties": {
        "alpha_rules": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "k": {
          "type": "integer",
          "minimum": 1
        },
        "semantic_calibration": {
          "enum": [
            "percentile"
          ]
        },
        "pair_affinity": {
          "type": "object",
          "required": [
            "asks_gives",
            "same_direction"
          ],
          "properties": {
            "asks_gives": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "same_direction": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            }
          }
        }
      }
    },
    "semantic": {
      "type": "object",
      "required": [
        "model",
        "dimensions",
        "batch_size",
        "calibration_sample"
      ],
      "additionalProperties": false,
      "properties": {
        "model": {
          "type": "string",
          "description": "Hugging Face model id for feature extraction."
        },
        "dimensions": {
          "type": "integer",
          "minimum": 8,
          "maximum": 1024,
          "description": "Dimensions kept after PCA."
        },
        "batch_size": {
          "type": "integer",
          "minimum": 1
        },
        "calibration_sample": {
          "type": "integer",
          "minimum": 100
        }
      }
    },
    "lands": {
      "type": "object"
    },
    "utility": {
      "type": "object",
      "required": [
        "useful_threshold"
      ],
      "properties": {
        "useful_threshold": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      }
    },
    "theme_support": {
      "type": "object",
      "required": [
        "min_cards",
        "floor_multiplier"
      ],
      "properties": {
        "min_cards": {
          "type": "integer",
          "minimum": 1
        },
        "floor_multiplier": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      }
    },
    "confidence": {
      "type": "object"
    },
    "profiles": {
      "type": "object",
      "required": [
        "default"
      ],
      "additionalProperties": {
        "type": "object",
        "required": [
          "synergy",
          "skeleton",
          "utility"
        ],
        "additionalProperties": false,
        "properties": {
          "synergy": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "skeleton": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "utility": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          }
        }
      }
    },
    "tiebreak": {
      "type": "array",
      "items": {
        "enum": [
          "synergy",
          "missing_asc",
          "name"
        ]
      }
    },
    "limits": {
      "type": "object",
      "additionalProperties": {
        "type": "number"
      }
    },
    "import": {
      "type": "object",
      "description": "Name resolution when importing a pool (RN-13).",
      "required": ["fuzzy_max_distance", "fuzzy_max_ratio", "max_suggestions"],
      "additionalProperties": false,
      "properties": {
        "fuzzy_max_distance": {
          "type": "integer",
          "minimum": 0,
          "maximum": 5,
          "description": "Most edits (insert, delete, change, swap) between a typo and a real name."
        },
        "fuzzy_max_ratio": {
          "type": "number",
          "minimum": 0,
          "maximum": 0.5,
          "description": "…and at most this share of the name's length."
        },
        "max_suggestions": {
          "type": "integer",
          "minimum": 1,
          "maximum": 20,
          "description": "Candidates offered for an ambiguous line."
        }
      }
    }
  }
}
